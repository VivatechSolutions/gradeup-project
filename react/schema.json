                        "type": "flashcard",
                        "card_title": "Factorizing the equation",
                        "front": "$(n + 37)(n - 36) = 0$",
                        "front_style": "math_formula",
                        "avatar_line": "The equation factors neatly into two terms: (n + 37) and (n - 36). These give us potential solutions for n.",
                        "avatar_emotion": "encouraging"
