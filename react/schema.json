                        "type": "flashcard",
                        "card_title": "Modulo operation",
                        "front": "54 mod 24 = 6",
                        "front_style": "math_formula",
                        "avatar_line": "This calculation tells us that 54 hours on a 24-hour clock is equivalent to 6 hours.",
                        "avatar_emotion": "encouraging"
                      },
                      {
                        "segment_id": "seg_004",
                        "type": "teaching",
                        "text": "So, 54:30 is equivalent to 6:30 on a 24-hour clock format.",
                        "emotion": "enthusiastic"
                      },
