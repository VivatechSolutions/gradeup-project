                      },
                      {
                        "segment_id": "fc_002",
                        "type": "flashcard",
                        "card_title": "Product of terms",
                        "front": "\\frac{a}{r} \\times a \\times ar = 343 \\Rightarrow a^3 = 343",
                        "front_style": "math_formula",
                        "avatar_line": "Multiplying these terms together, \\( \\frac{a}{r} \\times a \\times ar \\) simplifies to \\( a^3 \\). We set \\( a^3 = 343 \\) because that's the given product.",
                        "avatar_emotion": "encouraging"
