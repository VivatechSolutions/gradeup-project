                        "avatar_emotion": "encouraging"
                      },
                      {
                        "segment_id": "seg_003",
                        "type": "teaching",
                        "text": "We calculate 54 modulo 24 to bring the time back into a 24-hour clock format.",
                        "emotion": "enthusiastic"
                      },
                      {
