                      },
                      {
                        "segment_id": "fc_004",
                        "type": "flashcard",
                        "card_title": "Expand expressions",
                        "front": "\nx^2 - x = 2450 - x^2 - x",
                        "front_style": "math_formula",
                        "avatar_line": "By expanding, we simplify to this quadratic form that can help solve for x.",
                        "avatar_emotion": "explaining"
                      },
