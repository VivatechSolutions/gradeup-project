                      },
                      {
                        "segment_id": "fc_003",
                        "type": "flashcard",
                        "card_title": "Removing the fraction",
                        "front": "$n(n + 1) = 1332$",
                        "front_style": "math_formula",
                        "avatar_line": "By multiplying both sides by 2, we eliminate the denominator, leaving us with a simpler equation to work with.",
                        "avatar_emotion": "encouraging"
                      },
                      {
                        "segment_id": "seg_004",
                        "type": "teaching",
                        "text": "Next, let's rearrange this equation into a standard quadratic form.",
                        "emotion": "calm"
                      },
                      {
                        "segment_id": "fc_004",
                        "type": "flashcard",
                        "card_title": "Quadratic equation form",
                        "front": "$n^2 + n - 1332 = 0$",
                        "front_style": "math_formula",
                        "avatar_line": "This is a quadratic equation in standard form, which we can solve using factorization, the quadratic formula, or graphing.",
                        "avatar_emotion": "encouraging"
                      },
                      {
