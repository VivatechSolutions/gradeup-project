                "type": "example",
                "id": "2.17",
                "title": "Example 2.17",
                "content": "A man starts his journey from Chennai to Delhi by train. He starts at 22.30 hours on Wednesday. If it takes 32 hours of travelling time and assuming that the train is not late, when will he reach Delhi?",
                "content_context": "A man starts his journey from Chennai to Delhi by train. He starts at 22.30 hours on Wednesday. If it takes 32 hours of travelling time and assuming that the train is not late, when will he reach Delhi?",
                "enrichment": {
                  "avatar_explanation": {
                    "teaching_style": "step_by_step",
                    "total_duration_estimate": "5 minutes",
                    "segments": [
                      {
                        "segment_id": "seg_001",
                        "type": "teaching",
                        "text": "Let's work through this problem step-by-step. We need to find out when the man arrives in Delhi after travelling for 32 hours starting at 22:30 hours on Wednesday.",
                        "emotion": "enthusiastic"
                      },
                      {
                        "segment_id": "fc_001",
                        "type": "flashcard",
                        "card_title": "Working step",
                        "front": "22.30 (Starting Time) + 32 hours (Travelling Time)",
                        "front_style": "math_formula",
                        "avatar_line": "First, we add the travelling time of 32 hours to the starting time of 22:30.",
                        "avatar_emotion": "encouraging"
                      },
                      {
                        "segment_id": "seg_002",
                        "type": "teaching",
                        "text": "Now, when we add 32 hours to 22:30, we initially get 54:30. This is because 22 + 32 equals 54.",
                        "emotion": "enthusiastic"
                      },
                      {
                        "segment_id": "fc_002",
                        "type": "flashcard",
                        "card_title": "Working step",
                        "front": "54 hours 30 minutes modulo 24",
                        "front_style": "math_formula",
